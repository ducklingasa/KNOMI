menu "KNOMI Phase 0.3 heap spike"

config KNOMI_SPIKE_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config KNOMI_SPIKE_WIFI_PASSWORD
    string "Wi-Fi password (stored in local sdkconfig)"
    default ""

config KNOMI_SPIKE_PRINTER_HOST
    string "Printer host"
    default "192.168.0.55"

config KNOMI_SPIKE_PRINTER_PORT
    int "Printer WebSocket port"
    range 1 65535
    default 9999

endmenu